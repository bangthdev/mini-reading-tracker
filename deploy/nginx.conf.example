# Nginx config mẫu cho VPS Ubuntu 22.
# Chép vào /etc/nginx/sites-available/reading-tracker rồi:
#   ln -s /etc/nginx/sites-available/reading-tracker /etc/nginx/sites-enabled/
#   rm -f /etc/nginx/sites-enabled/default
#   nginx -t && systemctl reload nginx
#
# Thay DOMAIN bằng tên miền thật trước khi dùng.
# Khối HTTPS phía dưới do certbot tự sinh ra — chạy certbot trước, đừng tự viết tay.

server {
    listen 80;
    listen [::]:80;
    server_name DOMAIN;

    # Phục vụ frontend đã build (kết quả của `npm run build` bên frontend/)
    root /var/www/reading-tracker;
    index index.html;

    # Vue Router chạy history mode: mọi đường dẫn không khớp file nào
    # đều phải trả về index.html, để router phía trình duyệt tự xử lý.
    # Thiếu dòng này thì mở thẳng /shelf sẽ ra 404.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Chuyển tiếp API sang Express. Nhờ vậy trình duyệt chỉ nói chuyện với
    # một origin duy nhất, không cần cấu hình CORS.
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # Ảnh bìa đi qua backend nhưng ít đổi — cho trình duyệt cache lâu hơn
    location /api/covers/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        expires 1d;
        add_header Cache-Control "public";
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
}
